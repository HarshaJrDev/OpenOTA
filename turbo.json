{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      // Workspace deps (e.g. @openota/sdk -> @openota/shared) are consumed via their compiled
      // dist/*.d.ts output, not source — so type-checking a package requires its dependencies to
      // have been *built* first, not merely type-checked. "^check-types" alone left a clean CI
      // checkout with no dist/ at all, failing with "Cannot find module '@openota/shared'".
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
