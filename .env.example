# Copy to .env, then: docker compose up -d
# This configures the OpenOTA server run by docker-compose.yml at the repo root.
# Never commit the real .env — it's already in .gitignore.

PORT=3900
NODE_ENV=production

# --- Storage -----------------------------------------------------------------
# "local" (default): packages are stored on a persistent Docker volume (see docker-compose.yml)
#   — no external account needed. Good for self-hosting on a persistent VPS/machine.
# "supabase": packages are stored in your own private Supabase Storage bucket — needed if you're
#   deploying somewhere with an ephemeral filesystem (most PaaS providers). See
#   docs/STORAGE.md for exactly where to get these values and how to create the bucket.
STORAGE_PROVIDER=local

# --- Supabase (only read when STORAGE_PROVIDER=supabase) ---------------------
# Server-side only — NEVER put these in a React Native app, openota.config.json, or anywhere
# client-side. See docs/STORAGE.md.
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=openota-releases

# --- Package size --------------------------------------------------------------
# Deployment configuration, NOT an OpenOTA protocol limit — raise this freely on local storage or
# a paid Supabase plan. 50 only matches the Supabase Free plan's per-file cap.
OPENOTA_MAX_PACKAGE_SIZE_MB=50

# --- Authentication --------------------------------------------------------------
# Optional shared secret gating upload/rollback/delete (never check/download). Leave unset to run
# open. See docs/SELF_HOSTING.md "Authentication".
# OPENOTA_API_KEY=
