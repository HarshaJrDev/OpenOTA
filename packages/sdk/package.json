{
  "name": "@openota/sdk",
  "version": "0.2.1",
  "description": "Official React Native SDK for OpenOTA — check, download, verify and install OTA updates",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/HarshaJrDev/OpenOTA/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshaJrDev/OpenOTA.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/HarshaJrDev/OpenOTA/issues"
  },
  "keywords": [
    "ota",
    "react-native",
    "codepush",
    "openota",
    "over-the-air",
    "hot-update"
  ],
  "author": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@openota/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-fs": ">=2.20.0",
    "react-native-mmkv": ">=2.0.0",
    "react-native-nitro-modules": ">=0.31.2",
    "react-native-quick-base64": ">=3.0.0",
    "react-native-quick-crypto": ">=0.6.0",
    "react-native-zip-archive": ">=6.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/react": "^19.2.0",
    "eslint": "^9.39.1",
    "react": "19.2.0",
    "react-native": "^0.86.0",
    "react-native-fs": "^2.20.0",
    "react-native-mmkv": "^3.3.3",
    "react-native-quick-crypto": "^0.7.16",
    "react-native-zip-archive": "^7.0.2",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  }
}
