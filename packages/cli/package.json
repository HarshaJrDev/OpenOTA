    "form-data": "^4.0.1",
    "fs-extra": "^11.3.6",
    "ora": "^9.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.2",
