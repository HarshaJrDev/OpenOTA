{
  "name": "@openota/cli",
  "version": "0.2.3",
  "description": "Official CLI for OpenOTA — build, upload and release OTA packages for React Native apps",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/HarshaJrDev/OpenOTA/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshaJrDev/OpenOTA.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/HarshaJrDev/OpenOTA/issues"
  },
  "bin": {
    "openota": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  },
  "keywords": [
    "ota",
    "react-native",
    "codepush",
    "openota",
    "cli",
    "over-the-air"
  ],
  "author": "",
  "dependencies": {
    "@openota/shared": "workspace:*",
    "archiver": "^7.0.1",
    "axios": "^1.18.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "form-data": "^4.0.1",
    "fs-extra": "^11.3.6",
    "ora": "^9.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/adm-zip": "^0.5.6",
    "@types/archiver": "^6.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.3",
    "adm-zip": "^0.5.16",
    "eslint": "^9.39.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  }
}
