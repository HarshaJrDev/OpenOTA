{
  "name": "OpenOTA",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@openota/shared --filter=@openota/sdk --filter=@openota/cli && ./scripts/publish-changed.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.7.4",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@openota/sdk": "workspace:*"
  }
}
