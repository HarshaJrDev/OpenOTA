# Copy this file to .env and fill in real values. Never commit .env.

PORT=3001
NODE_ENV=development

# --- Database (multi-tenant Cloud metadata: users/projects/API keys) --------
# Only used by OpenOTA Cloud mode (dashboard accounts/projects). OTA package bytes are NOT stored
# here — those go to STORAGE_PROVIDER below.
#   Unset (default): an embedded PGlite database (in-process Postgres) persisted to ./data/pgdata.
#     Zero external infrastructure — ideal for local dev and small self-hosted deployments.
#   postgres://… : a managed Postgres. For OpenOTA Cloud, use your Supabase project's connection
#     string (Supabase dashboard → Project Settings → Database → Connection string → URI). Required
#     on hosts with an ephemeral filesystem (e.g. serverless/free tiers) so data survives restarts.
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# --- Session signing (Cloud dashboard auth) --------------------------------
# Required in production (NODE_ENV=production) — signs session tokens/cookies. Must be stable
# (>=16 chars); rotating it invalidates all logins. In dev a random per-boot value is used if unset.
# SESSION_SECRET=

# --- Storage ---------------------------------------------------------------
# "local" (default): OTA packages are stored on this machine's disk under STORAGE_ROOT.
#   No Supabase account needed — this is what self-hosters and local development use.
# "supabase": OTA packages are stored in a private Supabase Storage bucket. Required for the
#   Railway production deployment (Railway's filesystem is ephemeral).
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage

# --- Supabase (only read when STORAGE_PROVIDER=supabase) -------------------
# Server-side only. NEVER expose SUPABASE_SERVICE_ROLE_KEY to the CLI, SDK, dashboard, or any
# client. See README.md "Supabase Storage" section for where to obtain these values and how to
# create the private bucket.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=openota-releases

# --- Package size ------------------------------------------------------------
# Deployment configuration, NOT an OpenOTA protocol limit. The Supabase Free plan caps individual
# objects at 50MB; raise this if you're on a paid plan or using local storage.
OPENOTA_MAX_PACKAGE_SIZE_MB=200

# --- Authentication ------------------------------------------------------------
# Optional. Self-hosted OpenOTA has no account/org system — this is a single shared secret that
# gates uploads/rollback/delete (never check/list/download, which devices need unauthenticated).
# Leave unset to run open (fine for local dev, or a deployment already behind your own VPN/private
# network). Set a real value to require `openota login --api-key <this value>` from anyone who
# releases/rolls back through this server.
# OPENOTA_API_KEY=
