generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Platform {
  android
  ios
}

model OTAPackage {
  id        String   @id @default(cuid())
  version   String
  platform  Platform
  sha256    String
  size       Int
  path      String
  createdAt DateTime @default(now())

  @@unique([version, platform])
}